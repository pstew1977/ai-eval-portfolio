# Copy this file to .env and fill in your key.
# DeepEval uses an LLM as the "judge" that scores each metric.
# By default it uses OpenAI - you need an OpenAI API key with a small amount
# of credit (these test runs are cheap - a few pence to run this whole suite).
OPENAI_API_KEY=sk-your-key-here

# If you'd rather NOT use OpenAI, DeepEval also supports other providers
# (Azure OpenAI, Anthropic, local models via Ollama, etc). See:
# https://deepeval.com/docs/metrics-introduction#using-a-custom-llm
